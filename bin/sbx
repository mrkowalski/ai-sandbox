#!/bin/bash
#
# sbx - run a command inside the current folder's sandbox.
#
# Guarantees:
#   - the command runs exactly as given, attached to the terminal, with nothing
#     added; there is no default command; sbx exits with the command's status;
#   - everything sbx prints itself goes to stderr, so stdout carries only the
#     command's output (ACP depends on this);
#   - nothing is started, and no command runs, unless the config resolves, a
#     project .sbx/config is approved, the image builds, and the container
#     starts;
#   - the project's container is reused only when it was created from the same
#     resolved config and image; otherwise it is recreated, so a changed config
#     is never silently ignored.
#
# Usage:
#   sbx [--rebuild] [--up] [--] <cmd> [args...]
#   sbx [--rebuild] --up
#
#   --rebuild  rebuild the image without the build cache, then recreate the container
#   --up       bring the container up; with no command, exit 0 once it is up
#   --         end of options: the next word is the command, even if it starts with -
#
# Options are recognised only before the command. Host requirements: docker,
# devcontainer (@devcontainers/cli), jq, sha256sum, realpath.
#
# Host state, per project: ~/.local/state/sbx/<slug>/
#   approved            sha256 of the approved .sbx/config
#   policy/             the firewall policy, bound read-only at /usr/local/etc/sbx
#   devcontainer.json   the generated config passed to the devcontainer CLI

set -euo pipefail

SELF=$(readlink -f "${BASH_SOURCE[0]}")
# shellcheck source=../sbx-env.sh
. "$(dirname "$SELF")/../sbx-env.sh"

usage() {
    cat >&2 <<'EOF'
usage: sbx [--rebuild] [--up] [--] <cmd> [args...]
       sbx [--rebuild] --up

  --rebuild  rebuild the image without the build cache, then recreate the container
  --up       bring the container up; with no command, exit 0 once it is up
  --         end of options: the next word is the command, even if it starts with -

Examples:
  sbx claude --resume
  sbx bash
  sbx --up
  sbx --rebuild claude
EOF
}

die() { printf 'sbx: %s\n' "$*" >&2; exit 1; }

rebuild=0 up=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --rebuild) rebuild=1; shift ;;
        --up) up=1; shift ;;
        --) shift; break ;;
        -h|--help) usage; exit 0 ;;
        -*) printf 'sbx: unknown option: %s\n' "$1" >&2; usage; exit 2 ;;
        *) break ;;
    esac
done
if [ "$#" -eq 0 ] && [ "$up" -eq 0 ]; then
    usage
    exit 2
fi

for c in docker devcontainer jq sha256sum realpath; do
    command -v "$c" >/dev/null 2>&1 || die "'$c' is not on PATH; it is required on the host"
done

WS="$PWD"
SLUG=$(sbx_slug "$WS") || exit 1
STATE=$(sbx_state_dir "$SLUG")
NAME="sbx-$SLUG"

# A comma ends a field in a devcontainer mount string.
[[ "$WS" != *,* ]] || die "the workspace path contains a comma, which the mount syntax cannot carry: $WS"
[[ "$STATE" != *,* ]] || die "the state path contains a comma, which the mount syntax cannot carry: $STATE"

# 1-2. Config and approval.
sbx_resolve "$WS" || die "invalid config; nothing was started"
sbx_approve "$WS" || exit 1

# 3. Image, tagged by content: the sandbox files that go into the build, and
#    the tool list. Domains are not in it; they never enter the image.
TOOLS="${SBX_TOOLS[*]}"
IMAGE_HASH=$(
    {
        cd "$SBX_DEVCONTAINER"
        find . -type f ! -path ./CLAUDE.md ! -path ./sbx-defaults.conf -print0 \
            | LC_ALL=C sort -z | xargs -0 sha256sum
        printf 'tools=%s\n' "$TOOLS"
    } | sha256sum | cut -c1-16
)
IMAGE="sbx-img:$IMAGE_HASH"

if [ "$rebuild" -eq 1 ] || ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    build_args=(--build-arg "TOOLS=$TOOLS" -t "$IMAGE")
    [ "$rebuild" -eq 1 ] && build_args+=(--no-cache)
    printf 'sbx: building %s (tools: %s)\n' "$IMAGE" "${TOOLS:-none}" >&2
    docker build "${build_args[@]}" "$SBX_DEVCONTAINER" >&2 </dev/null \
        || die "the image build failed; nothing was started"
fi
IMAGE_ID=$(docker image inspect --format '{{.Id}}' "$IMAGE") || die "cannot inspect $IMAGE"

# 4. Policy dir and generated config.
mkdir -p -m 700 "$STATE"
mkdir -p "$STATE/policy"
chmod 755 "$STATE/policy"
{
    printf '# Generated by sbx for %s. Edit the config, not this file.\n' "$WS"
    printf '%s\n' "${SBX_WHITELIST[@]}"
} > "$STATE/policy/allowed-domains.txt"
printf 'HOST_NETWORK=%s\n' "$SBX_HOST_NETWORK" > "$STATE/policy/firewall.conf"
chmod 644 "$STATE/policy/allowed-domains.txt" "$STATE/policy/firewall.conf"

mounts=() runargs=("--name=$NAME")
for v in "${SBX_TOOL_VOLUMES[@]}"; do
    IFS='|' read -r t kind path <<<"$v"
    mounts+=("source=sbx-$t-$kind-\${localEnv:SBX_SLUG}-\${devcontainerId},target=$path,type=volume")
done
for v in "${SBX_TOOL_TMPFS[@]}"; do
    runargs+=("--tmpfs=${v#*|}:rw,noexec,nosuid,mode=1777")
done
mounts+=("source=$STATE/policy,target=/usr/local/etc/sbx,type=bind,readonly")
if [ -e "$WS/.sbx" ]; then
    mounts+=("source=\${localWorkspaceFolder}/.sbx,target=\${localWorkspaceFolder}/.sbx,type=bind,readonly")
fi
for m in "${SBX_MOUNTS[@]}"; do
    p="${m%|*}"
    if [ "${m##*|}" = rw ]; then mounts+=("source=$p,target=$p,type=bind")
    else mounts+=("source=$p,target=$p,type=bind,readonly"); fi
done

# json_array <string>... - a JSON array of the arguments. Not `jq --args`:
# jq would read an argument such as --name=... as one of its own options.
# Values carry no newlines; the config parser rejects control characters.
json_array() {
    if [ "$#" -eq 0 ]; then printf '[]'; return; fi
    printf '%s\n' "$@" | jq -R . | jq -s .
}

CFG=$(jq \
    --arg image "$IMAGE" \
    --argjson mounts "$(json_array "${mounts[@]}")" \
    --argjson runargs "$(json_array "${runargs[@]}")" \
    --argjson env "$(json_array "${SBX_TOOL_ENV[@]}" \
                     | jq '[.[] | capture("^(?<k>[^=]+)=(?<v>.*)$") | {(.k): .v}] | add // {}')" \
    'del(.build) | .image = $image
     | .runArgs += $runargs
     | .mounts += $mounts
     | .containerEnv += $env' \
    "$SBX_DEVCONTAINER/devcontainer.json") || die "cannot generate the devcontainer config"

CONFIG_HASH=$(
    {
        printf '%s\n' "$CFG" "$IMAGE_ID"
        cat "$STATE/policy/allowed-domains.txt" "$STATE/policy/firewall.conf"
    } | sha256sum | cut -c1-16
)
GEN="$STATE/devcontainer.json"
jq --arg label "--label=sbx.config=$CONFIG_HASH" '.runArgs += [$label]' <<<"$CFG" > "$GEN.tmp"
mv "$GEN.tmp" "$GEN"

# 5. Reuse or recreate. The name carries no devcontainerId, so two workspace
#    paths can derive the same one; the other project's container is never
#    touched.
remove=0
if docker container inspect "$NAME" >/dev/null 2>&1; then
    folder=$(docker container inspect --format '{{index .Config.Labels "devcontainer.local_folder"}}' "$NAME")
    if [ "$folder" != "$WS" ]; then
        die "container $NAME already exists for '$folder', whose path derives the same name; it was left running. Remove it, or launch this project from another path."
    fi
    label=$(docker container inspect --format '{{index .Config.Labels "sbx.config"}}' "$NAME")
    if [ "$label" != "$CONFIG_HASH" ]; then
        printf 'sbx: config or image changed; recreating %s\n' "$NAME" >&2
        remove=1
    fi
fi
[ "$rebuild" -eq 1 ] && remove=1

export SBX_SLUG="$SLUG"
up_args=(--workspace-folder "$WS" --config "$GEN")
[ "$remove" -eq 1 ] && up_args+=(--remove-existing-container)
if ! devcontainer up "${up_args[@]}" </dev/null >&2; then
    die "the container did not come up, or post-start verification failed; see the output above and 'docker logs $NAME'. No command was run."
fi

# 6. Cosmetic; never fails the launch.
sbx_tag_image "$WS"

# 7. The command, verbatim.
[ "$#" -gt 0 ] || exit 0
exec devcontainer exec --workspace-folder "$WS" --config "$GEN" "$@"
