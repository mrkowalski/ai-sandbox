{
  "name": "sbx",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    "--read-only",
    "--tmpfs=/tmp"
  ],
  "remoteUser": "node",
  "initializeCommand": "mkdir -p '${localWorkspaceFolder}/.git'",
  "mounts": [
    "source=sbx-bashhistory-${localEnv:SBX_SLUG}-${devcontainerId},target=/commandhistory,type=volume",
    "source=sbx-npm-${localEnv:SBX_SLUG}-${devcontainerId},target=/home/node/.npm,type=volume",
    "source=sbx-uv-${localEnv:SBX_SLUG}-${devcontainerId},target=/home/node/.cache/uv,type=volume",
    "source=${localWorkspaceFolder}/.git,target=${localWorkspaceFolder}/.git,type=bind,readonly"
  ],
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "TZ": "Europe/Warsaw",
    "COLORTERM": "truecolor",
    "SBX_WORKSPACE": "${localWorkspaceFolder}"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",

  "overrideCommand": false,

  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh && /usr/local/bin/verify.sh",
  "waitFor": "postStartCommand"
}
